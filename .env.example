# ============================================================
# HealthHub — Environment Variables (Next.js + PostgreSQL)
# Salin file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env
# ============================================================

# WAJIB. Connection string PostgreSQL.
# Catatan: proses `next build` juga memerlukan variabel ini (boleh nilai dummy
# saat build, karena tidak ada koneksi DB saat build).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app1_db

# Opsional — hanya dipakai saat `next start` / production.
# PORT=3000
# NODE_ENV=production

# Catatan provider cloud (contoh format):
# Neon      : postgresql://USER:PASS@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Supabase  : postgresql://postgres.PROJECT_REF:PASS@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Railway   : postgresql://postgres:PASS@containers-us-west-xx.railway.app:6543/railway
# Render    : postgresql://USER:PASS@dpg-xxxx-a.oregon-postgres.render.com/dbname
